# Files that `vercel deploy` (CLI) should not upload. Git-based deploys never include tests/ in the app anyway.
# Screenshots and Figma references used only by the local tests/visual scripts
tests/visual/baselines
tests/visual/references

# Test output and local files. Anchored with "/": a bare "data" would also match src/data, the template's JSON data,
# and the build would fail with those files missing.
test-results
playwright-report
/data
/uploads
*.tsbuildinfo
